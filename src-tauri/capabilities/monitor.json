{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "monitor-capability",
  "description": "Capabilities for Monitor windows",
  "windows": ["monitor-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://0.0.0.0:*" },
        { "url": "https://*" },
        { "url": "http://" }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "store:default",
    "keyring:default",
    "dialog:default"
  ]
}
